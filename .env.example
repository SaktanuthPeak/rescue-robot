# Raspberry Pi AP deployment example.
# Copy to .env next to docker-compose.yml, then run `docker compose up -d --build`.

# --- ports ---------------------------------------------------------------------------
WEB_PORT=80
API_PORT=9000

# Compose files used by default on the Raspberry Pi. Linux uses ':' between files.
# The receiver-canbus Arduino is the default USB device. Add
# :docker-compose.camera.yml only when /dev/video0 exists.
COMPOSE_FILE=docker-compose.yml:docker-compose.rpi-ap.yml:docker-compose.robot-serial.yml

# Raspberry Pi AP overlay values. These names intentionally do not collide with
# the laptop development .env values.
# Leave empty to use same-origin API and WebSocket connections.
RPI_PUBLIC_API_URL=
RPI_WEB_PORT=80
RPI_API_PORT=9000
RPI_NODE_MAX_OLD_SPACE_SIZE=4096
# Host interface the API port is published on. 127.0.0.1 keeps it Pi-local (the tablet
# reaches the API through the frontend's nginx proxy); use 0.0.0.0 to expose it on the AP.
API_BIND_HOST=127.0.0.1

# --- frontend (build-time; a change here needs `--build`) -----------------------------
# Leave empty to use the browser's current host/IP.
PUBLIC_API_URL=
PUBLIC_APP_TITLE=FireBot

# --- backend -------------------------------------------------------------------------
DEBUG=False
LOGGING_LEVEL=20
TITLE=FireBot API
VERSION=0.1.0
DATABASE_URI=
# Required. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me
ALLOW_HOSTS=["*"]

# --- telemetry -----------------------------------------------------------------------
# Receiver-canbus sends RB3 with flame, battery and CAN status.
TELEMETRY_SOURCE=receiver
FLAME_SERIAL_PORT=/dev/ttyACM0
FLAME_SERIAL_BAUDRATE=115200
FLAME_SERIAL_TIMEOUT_S=1.0
FLAME_SERIAL_BOOT_DELAY_S=2.0
FLAME_SERIAL_RECONNECT_S=2.0
FLAME_ADC_MAX=1023
FLAME_THRESHOLD=400
FLAME_ACTIVE_LOW=True
TELEMETRY_MOCK_INTERVAL_MS=100
TELEMETRY_MIN_BROADCAST_INTERVAL_MS=50
TELEMETRY_STALE_AFTER_MS=1500

# --- receiver-canbus control ---------------------------------------------------------
ROBOT_SERIAL_ENABLED=True
ROBOT_SERIAL_PORT=/dev/ttyACM0
ROBOT_SERIAL_BAUDRATE=115200
ROBOT_SERIAL_TIMEOUT_S=1.0
ROBOT_SERIAL_BOOT_DELAY_S=2.0
ROBOT_SERIAL_RECONNECT_S=2.0

# Host gid of the dialout group (receiver USB serial overlay).
SERIAL_GROUP_ID=20

# --- camera --------------------------------------------------------------------------
# USB camera exposed to the backend as /dev/video0 by docker-compose.camera.yml.
CAMERA_SOURCE=auto
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=320
CAMERA_HEIGHT=240
CAMERA_FPS=30
CAMERA_AUTO_START=True
