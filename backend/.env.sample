APP_ENV="dev"
DEBUG=True
TITLE="FireBot API"
VERSION="0.1.0"

# Phase 1 needs no MongoDB. Leave DATABASE_URI blank to skip Beanie init entirely;
# set it once you add persisted models (Phase 2 flame event history).
DATABASE_URI=""

SECRET_KEY="Th1s_1s_my_3xampl3_0f_s3cr3t_k3y_0123456789"
ALLOW_HOSTS='["*"]' # Production must not be *, must be real hostname

# --- Telemetry / flame sensors (Phase 1) ---
# "mock" generates a virtual flame orbiting the robot -- no hardware needed.
# "serial" reads real FB1 frames from FLAME_SERIAL_PORT.
TELEMETRY_SOURCE="mock"
FLAME_SERIAL_PORT="/dev/ttyACM0"
FLAME_SERIAL_BAUDRATE=115200
FLAME_SERIAL_TIMEOUT_S=1.0
FLAME_SERIAL_BOOT_DELAY_S=2.0
FLAME_SERIAL_RECONNECT_S=2.0

# 10-bit ADC on an Uno R3. Polarity + threshold live here, not on the wire, so they
# can be retuned without reflashing the board.
FLAME_ADC_MAX=1023
FLAME_THRESHOLD=400
FLAME_ACTIVE_LOW=True

TELEMETRY_MOCK_INTERVAL_MS=100
TELEMETRY_MIN_BROADCAST_INTERVAL_MS=50
TELEMETRY_STALE_AFTER_MS=1500

# --- Camera / video streaming ---
# "auto" probes hardware /dev/video0 and falls back to mock generator if not found.
# "mock" runs pure-python simulated HUD camera.
# "v4l2" reads USB webcam via OpenCV.
CAMERA_SOURCE="auto"
CAMERA_DEVICE="/dev/video0"
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
CAMERA_AUTO_START=True
